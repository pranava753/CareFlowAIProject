# Copy to .env and fill in whichever provider's key you have -- LiteLLM picks
# the right one based on the model prefix below (e.g. "groq/..." uses
# GROQ_API_KEY). Only one is required.
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# LiteLLM model ids (any LiteLLM-supported provider/model string works here).
# Examples: "gpt-4o-mini" (OpenAI), "groq/llama-3.3-70b-versatile" (Groq),
# "claude-3-5-haiku-20241022" (Anthropic).
CAREFLOW_LLM_MODEL=gpt-4o-mini
CAREFLOW_JUDGE_MODEL=gpt-4o-mini

# Local embedded stores (no Docker/server required).
CAREFLOW_DATA_DIR=./data/careflow
CAREFLOW_QDRANT_PATH=./data/careflow/qdrant_store
CAREFLOW_QDRANT_COLLECTION=careflow_policy_corpus
CAREFLOW_BM25_INDEX_PATH=./data/careflow/bm25_index.pkl
CAREFLOW_PATIENT_MEMORY_DB=./data/careflow/memory/patient_memory.sqlite

# Local models (downloaded on first use, cached by sentence-transformers).
CAREFLOW_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CAREFLOW_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Optional -- LangFuse tracing (M7). Leave blank to disable; the app runs
# fine without it, it just won't emit traces.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
